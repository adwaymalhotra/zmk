            slow-release;
        };
        combo_LCTL_Sym_0 {
            timeout-ms = <COMBO_TERM>;
            key-positions = <34 13>;
            bindings = <&macro_LCTL_Sym_0>;
            slow-release;
        };
        combo_LGUI_Sym_1 {
            timeout-ms = <COMBO_TERM>;
            key-positions = <34 13>;
