        };
        n7_pgdn_0: n7_pgdn_0 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N7>, <&kp PG_DN>;
            mods = <(MOD_LGUI|MOD_LALT)>;
            keep-mods = <(MOD_LGUI|MOD_LALT)>;
        };
        n7_pgdn_1: n7_pgdn_1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N7>, <&kp PG_DN>;
            mods = <(MOD_LCTL|MOD_LALT)>;
            keep-mods = <(MOD_LCTL|MOD_LALT)>;
        };
        n8_pgup_0: n8_pgup_0 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N8>, <&kp PG_UP>;
            mods = <(MOD_LGUI|MOD_LALT)>;
            keep-mods = <(MOD_LGUI|MOD_LALT)>;
        };
        n8_pgup_1: n8_pgup_1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N8>, <&kp PG_UP>;
            mods = <(MOD_LCTL|MOD_LALT)>;
            keep-mods = <(MOD_LCTL|MOD_LALT)>;
        };
        dot_home_0: dot_home_0 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp HOME>;
            mods = <(MOD_LGUI|MOD_LALT)>;
