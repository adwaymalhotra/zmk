            timeout-ms = <COMBO_TERM>;
            key-positions = <34 11>;
            bindings = <&macro_LALT_Sym_0>;
            slow-release;
        };
        combo_LALT_Sym_1 {
            timeout-ms = <COMBO_TERM>;
            key-positions = <34 11>;
            bindings = <&macro_LALT_Sym_1>;
            slow-release;
        };
        combo_LSHFT_Sym_0 {
            timeout-ms = <COMBO_TERM>;
            key-positions = <34 10>;
            bindings = <&macro_LSHFT_Sym_0>;
            slow-release;
        };
        combo_LSHFT_Sym_1 {
            timeout-ms = <COMBO_TERM>;
            key-positions = <34 10>;
            bindings = <&macro_LSHFT_Sym_1>;
            slow-release;
        };
        combo_LGUI_LCTL_Sym_0 {
            timeout-ms = <COMBO_TERM>;
            key-positions = <34 12 13>;
            bindings = <&macro_LGUI_LCTL_Sym_0>;
            slow-release;
        };
        combo_LCTL_LGUI_Sym_1 {
            timeout-ms = <COMBO_TERM>;
            key-positions = <34 12 13>;
            bindings = <&macro_LCTL_LGUI_Sym_1>;
            slow-release;
        };
        combo_LGUI_LALT_Sym_0 {
            timeout-ms = <COMBO_TERM>;
            key-positions = <34 12 11>;
            bindings = <&macro_LGUI_LALT_Sym_0>;
            slow-release;
        };
        combo_LCTL_LALT_Sym_1 {
            timeout-ms = <COMBO_TERM>;
            key-positions = <34 12 11>;
            bindings = <&macro_LCTL_LALT_Sym_1>;
            slow-release;
        };
        combo_LGUI_LSHFT_Sym_0 {
            timeout-ms = <COMBO_TERM>;
            key-positions = <34 12 10>;
            bindings = <&macro_LGUI_LSHFT_Sym_0>;
            slow-release;
        };
        combo_LCTL_LSHFT_Sym_1 {
            timeout-ms = <COMBO_TERM>;
            key-positions = <34 12 10>;
            bindings = <&macro_LCTL_LSHFT_Sym_1>;
            slow-release;
        };
        combo_LCTL_LALT_Sym_0 {
            timeout-ms = <COMBO_TERM>;
            key-positions = <34 13 11>;
            bindings = <&macro_LCTL_LALT_Sym_0>;
            slow-release;
        };
        combo_LGUI_LALT_Sym_1 {
            timeout-ms = <COMBO_TERM>;
            key-positions = <34 13 11>;
            bindings = <&macro_LGUI_LALT_Sym_1>;
            slow-release;
        };
        combo_LCTL_LSHFT_Sym_0 {
            timeout-ms = <COMBO_TERM>;
            key-positions = <34 13 10>;
            bindings = <&macro_LCTL_LSHFT_Sym_0>;
            slow-release;
        };
        combo_LGUI_LSHFT_Sym_1 {
            timeout-ms = <COMBO_TERM>;
            key-positions = <34 13 10>;
            bindings = <&macro_LGUI_LSHFT_Sym_1>;
            slow-release;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer_Fn_0 {
            if-layers = <Nav_0 Sym_0>;
            then-layer = <Fn_0>;
        };
        tri_layer_Fn_1 {
            if-layers = <Nav_1 Sym_1>;
            then-layer = <Fn_1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Graphite_0 {
            display-name = "Graphite 0";
            bindings = <
                &kp B &kp L &kp D &kp W &kp Z /**/ &sqt_dqt &kp F &kp O &kp U &kp J
                &kp N &kp R &kp T &kp S &kp G /**/ &kp Y &kp H &kp A &kp E &kp I
                &kp Q &kp X &kp M &kp C &kp V /**/ &kp K &kp P &dot_col &kp MINUS &com_sem
                &mt LGUI ESC &mo Nav_0 &kp LSHFT /**/ &thm LCTL SPACE &mo Sym_0 &mt LCTL RET
            >;
        };
        Graphite_1 {
            display-name = "Graphite 1";
            bindings = <
                &kp B &kp L &kp D &kp W &kp Z /**/ &sqt_dqt &kp F &kp O &kp U &kp J
                &kp N &kp R &kp T &kp S &kp G /**/ &kp Y &kp H &kp A &kp E &kp I
                &kp Q &kp X &kp M &kp C &kp V /**/ &kp K &kp P &dot_col &kp MINUS &com_sem
                &mt LCTL ESC &mo Nav_1 &kp LSHFT /**/ &thm LGUI SPACE &mo Sym_1 &mt LGUI RET
            >;
        };
        Qwerty_0 {
            display-name = "Qwerty 0";
            bindings = <
                &kp Q &kp W &kp E &kp R &kp T /**/ &kp Y &kp U &kp I &kp O &kp P
                &kp A &kp S &kp D &kp F &kp G /**/ &kp H &kp J &kp K &kp L &kp SEMI
                &kp Z &kp X &kp C &kp V &kp B /**/ &kp N &kp M &kp COMMA &kp DOT &kp FSLH
                &mt LGUI ESC &mo Nav_0 &kp LSHFT /**/ &thm LCTL SPACE &mo Sym_0 &mt LCTL RET
            >;
        };
        Qwerty_1 {
            display-name = "Qwerty 1";
            bindings = <
                &kp Q &kp W &kp E &kp R &kp T /**/ &kp Y &kp U &kp I &kp O &kp P
                &kp A &kp S &kp D &kp F &kp G /**/ &kp H &kp J &kp K &kp L &kp SEMI
                &kp Z &kp X &kp C &kp V &kp B /**/ &kp N &kp M &kp COMMA &kp DOT &kp FSLH
                &mt LCTL ESC &mo Nav_1 &kp LSHFT /**/ &thm LGUI SPACE &mo Sym_1 &mt LGUI RET
            >;
        };
        Nav_0 {
            display-name = "Nav 0";
            bindings = <
                &alt_tab &kp LS(TAB) &pre_tab &nex_tab &kp PRCNT /**/ &dot_home_0 &n7_pgdn_0 &n8_pgup_0 &n9_end_0 &kp FSLH
                &sk LSHFT &sk LALT &sk LGUI &sk LCTL &kp STAR /**/ &eql_left_0 &n4_down_0 &n5_up_0 &n6_right_0 &n0_ret_0
                &vi_sav &key_repeat &kp TAB &kp ESC &kp QMARK /**/ &kp MINUS &kp N1 &kp N2 &kp N3 &kp PLUS
                &trans &trans &trans /**/ &trans &trans &trans
            >;
        };
        Nav_1 {
            display-name = "Nav 1";
            bindings = <
                &gui_tab &kp LS(TAB) &pre_tab &nex_tab &kp PRCNT /**/ &dot_home_1 &n7_pgdn_1 &n8_pgup_1 &n9_end_1 &kp FSLH
                &sk LSHFT &sk LALT &sk LCTL &sk LGUI &kp STAR /**/ &eql_left_1 &n4_down_1 &n5_up_1 &n6_right_1 &n0_ret_1
                &vi_sav &key_repeat &kp TAB &kp ESC &kp QMARK /**/ &kp MINUS &kp N1 &kp N2 &kp N3 &kp PLUS
                &trans &trans &trans /**/ &trans &trans &trans
            >;
        };
        Sym_0 {
            display-name = "Sym 0";
            bindings = <
                &kp GRAVE &kp LT &kp LBKT &kp RBKT &kp GT /**/ &kp HOME &kp PG_DN &kp PG_UP &kp END &sk RALT
                &hrm_l LSHFT EXCL &hrm_l LALT GB_AT &hrm_l LGUI LPAR &hrm_l LCTL RPAR &kp GB_HASH /**/ &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp RET
                &kp AMPS &kp DLLR &kp LBRC &kp RBRC &kp CARET /**/ &del_wor &kp BSPC &kp DEL &kp INS &kp GB_BSLH
                &trans &trans &trans /**/ &trans &trans &trans
            >;
        };
        Sym_1 {
            display-name = "Sym 1";
            bindings = <
                &kp GRAVE &kp LT &kp LBKT &kp RBKT &kp GT /**/ &kp HOME &kp PG_DN &kp PG_UP &kp END &sk RALT
                &hrm_l LSHFT EXCL &hrm_l LALT GB_AT &hrm_l LCTL LPAR &hrm_l LGUI RPAR &kp GB_HASH /**/ &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp RET
                &kp AMPS &kp DLLR &kp LBRC &kp RBRC &kp CARET /**/ &del_wor &kp BSPC &kp DEL &kp INS &kp GB_BSLH
                &trans &trans &trans /**/ &trans &trans &trans
            >;
        };
        Fn_0 {
            display-name = "Fn 0";
            bindings = <
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 /**/ &kp F6 &kp F7 &kp F8 &kp F9 &kp F10
                &sk LSHFT &sk LALT &sk LGUI &sk LCTL &kp F11 /**/ &kp F12 &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE &vi_sav
                &tog sys_0 &none &none &none &none /**/ &kp CAPS &kp C_BRI_DN &kp C_BRI_UP &none &kp PSCRN
                &trans &trans &trans /**/ &trans &trans &trans
            >;
        };
        Fn_1 {
            display-name = "Fn 1";
            bindings = <
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 /**/ &kp F6 &kp F7 &kp F8 &kp F9 &kp F10
                &sk LSHFT &sk LALT &sk LCTL &sk LGUI &kp F11 /**/ &kp F12 &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE &vi_sav
                &tog sys_1 &none &none &none &none /**/ &kp CAPS &kp C_BRI_DN &kp C_BRI_UP &none &kp PSCRN
                &trans &trans &trans /**/ &trans &trans &trans
            >;
        };
        sys_0 {
            display-name = "sys 0";
            bindings = <
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR /**/ &bt BT_CLR_ALL &none &none &none &tog Graphite_1
                &none &none &kp C_BRI_UP &kp C_BRI_DN &sys_reset /**/ &sys_reset &none &none &none &tog Qwerty_0
                &out OUT_BLE &out OUT_USB &none &none &bootloader /**/ &bootloader &none &none &none &tog Qwerty_1
                &trans &trans &trans /**/ &trans &trans &trans
            >;
        };
        sys_1 {
            display-name = "sys 1";
            bindings = <
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR /**/ &bt BT_CLR_ALL &none &none &none &tog Graphite_1
                &none &none &kp C_BRI_UP &kp C_BRI_DN &sys_reset /**/ &sys_reset &none &none &none &tog Qwerty_0
                &out OUT_BLE &out OUT_USB &none &none &bootloader /**/ &bootloader &none &none &none &tog Qwerty_1
                &trans &trans &trans /**/ &trans &trans &trans
            >;
        };
    };
};