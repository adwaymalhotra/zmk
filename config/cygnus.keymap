            bindings = <&macro_LGUI_LSHFT_Nav_0>;
            slow-release;
        };
        combo_LCTL_LSHFT_Nav_1 {
            timeout-ms = <COMBO_TERM>;
            key-positions = <31 12 10>;
            bindings = <&macro_LCTL_LSHFT_Nav_1>;
            slow-release;
        };
        combo_LCTL_LALT_Nav_0 {
            timeout-ms = <COMBO_TERM>;
            key-positions = <31 13 11>;
            bindings = <&macro_LCTL_LALT_Nav_0>;
            slow-release;
        };
        combo_LGUI_LALT_Nav_1 {
            timeout-ms = <COMBO_TERM>;
            key-positions = <31 13 11>;
