            timeout-ms = <COMBO_TERM>;
            key-positions = <31 10>;
            bindings = <&macro_LSHFT_Nav_0>;
            slow-release;
        };
        combo_LSHFT_Nav_1 {
            timeout-ms = <COMBO_TERM>;
            key-positions = <31 10>;
            bindings = <&macro_LSHFT_Nav_1>;
            slow-release;
        };
        combo_LGUI_LCTL_Nav_0 {
            timeout-ms = <COMBO_TERM>;
            key-positions = <31 12 13>;
            bindings = <&macro_LGUI_LCTL_Nav_0>;
            slow-release;
        };
        combo_LCTL_LGUI_Nav_1 {
            timeout-ms = <COMBO_TERM>;
