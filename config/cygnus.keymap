            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&kp LEFT>;
            mods = <(MOD_LGUI|MOD_LALT)>;
            keep-mods = <(MOD_LGUI|MOD_LALT)>;
        };
        eql_left_1: eql_left_1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&kp LEFT>;
            mods = <(MOD_LCTL|MOD_LALT)>;
            keep-mods = <(MOD_LCTL|MOD_LALT)>;
        };
        n4_down_0: n4_down_0 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
