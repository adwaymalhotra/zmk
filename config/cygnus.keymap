            slow-release;
        };
        combo_LGUI_Sym_0 {
            timeout-ms = <COMBO_TERM>;
            key-positions = <34 12>;
            bindings = <&macro_LGUI_Sym_0>;
            slow-release;
        };
        combo_LCTL_Sym_1 {
            timeout-ms = <COMBO_TERM>;
