        n9_end_mac: n9_end_mac {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N9>, <&kp END>;
            mods = <(MOD_LCTL|LALT)>;
            keep-mods = <(MOD_LCTL|LALT)>;
        };
        alt_tab: alt_tab {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&kt_on LALT>, <&kp TAB>, <&kt_off LALT>;
            ignored-key-positions = <1>;
        };
        ctl_tab: ctl_tab {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&kt_on LCTL>, <&kp TAB>, <&kt_off LCTL>;
            ignored-key-positions = <1>;
        };
        gui_tab: gui_tab {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&kt_on LGUI>, <&kp TAB>, <&kt_off LGUI>;
            ignored-key-positions = <1>;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";
        combo_degree {
            timeout-ms = <COMBO_TERM>;
            key-positions = <0 10>;
            bindings = <&uc_deg>;
        };
        combo_bootloader {
            timeout-ms = <COMBO_TERM>;
            key-positions = <4 3 6 5>;
            bindings = <&bootloader>;
        };
        combo_reset {
            timeout-ms = <COMBO_TERM>;
            key-positions = <4 5>;
            bindings = <&sys_reset>;
        };
        combo_LCTL_Nav {
            timeout-ms = <COMBO_TERM>;
            key-positions = <33 13>;
            bindings = <&macro_LCTL_Nav>;
            layers = <0 2>;
            slow-release;
