        };
        n9_end: n9_end {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N9>, <&kp END>;
            mods = <(MOD_LGUI|LALT)>;
            keep-mods = <(MOD_LGUI|LALT)>;
