            mods = <(LSHFT)>;
        };
        com_sem: com_sem {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SEMICOLON>;
            mods = <(LSHFT)>;
        };
        sqt_dqt: sqt_dqt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SQT>, <&kp GB_DQT>;
            mods = <(LSHFT)>;
        };
        lpar_lt: lpar_lt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LPAR>, <&kp LT>;
            mods = <(LSHFT)>;
        };
        rpar_gt: rpar_gt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RPAR>, <&kp GT>;
            mods = <(LSHFT)>;
        };
        eql_left: eql_left {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&kp LEFT>;
            mods = <(MOD_LGUI|LALT)>;
            keep-mods = <(MOD_LGUI|LALT)>;
        };
        eql_left_mac: eql_left_mac {
            compatible = "zmk,behavior-mod-morph";
