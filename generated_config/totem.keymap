        };
        n7_pgdn_mac: n7_pgdn_mac {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N7>, <&kp PG_DN>;
            mods = <(MOD_LCTL|LALT)>;
